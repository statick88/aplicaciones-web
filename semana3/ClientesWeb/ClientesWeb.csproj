<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Proyecto web de la Semana 3: ASP.NET Core MVC sobre .NET 10.
    `Sdk.Web` es el que trae el framework compartido de ASP.NET Core,
    así que aquí solo se declara el paquete que falta.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClientesWeb</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MySqlConnector: driver MySQL para .NET con API asíncrona y
      consultas parametrizadas. Es el equivalente a mysqli/prepare()
      que se usó en la Semana 2.
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
